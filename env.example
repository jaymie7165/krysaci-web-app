# PostgreSQL (na Railway se doplní automaticky, když přidáš službu PostgreSQL a propojíš proměnnou)
DATABASE_URL="postgresql://user:password@localhost:5432/playhaven"

# Auth.js – vygeneruj příkazem: npx auth secret   (nebo: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Discord OAuth2 aplikace (https://discord.com/developers/applications -> OAuth2)
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Sdílený tajný klíč pro tvého Discord bota (bot ho posílá v hlavičce x-bot-key)
BOT_API_KEY=""

# Discord ID uživatelů, kteří se po přihlášení stanou adminy (oddělené čárkou)
ADMIN_DISCORD_IDS=""

# Veřejná adresa webu (na Railway tvoje doména)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
