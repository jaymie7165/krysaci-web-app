generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MOD
  ADMIN
}

enum FriendStatus {
  PENDING
  ACCEPTED
}

enum EventStatus {
  UPCOMING
  LIVE
  FINISHED
  CANCELLED
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

model User {
  id           String   @id @default(cuid())
  discordId    String   @unique
  username     String
  handle       String   @unique
  avatarUrl    String?
  bio          String?
  accent       String   @default("#8b5cf6")
  locale       String   @default("cs")
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  showActivity Boolean  @default(true) // zda web ukazuje, jakou hru hráč právě hraje
  bannedAt     DateTime? // zablokovaný hráč se přihlásí, ale nemůže nic dělat
  banReason    String?
  onboardingDismissed Boolean @default(false)
  theme        String? // barevné téma webu (pink, indigo, ...)
  notifyDiscord Boolean @default(true) // posílat oznámení i do Discord DM přes bota
  twitchLogin  String?
  kickLogin    String?

  gameProfiles      GameProfile[]
  stats             PlayerStat[]
  sentFriends       Friendship[]      @relation("Requester")
  receivedFriends   Friendship[]      @relation("Addressee")
  lfgPosts          LfgPost[]
  lfgJoins          LfgJoin[]
  tournaments       Tournament[]
  tournamentEntries TournamentEntry[]
  customs           Custom[]
  customEntries     CustomEntry[]
  tickets           Ticket[]
  ticketMessages    TicketMessage[]
  suggestions       GameSuggestion[]
  votes             GameVote[]
  linkedAccounts    LinkedAccount[]
  captainOf         TournamentTeam[]  @relation("TeamCaptain")
  picks             Pick[]
  news              News[]
  teamMemberships   TeamMember[]
  badges            Badge[]
  notifications     Notification[]
  pet               Pet?
  petStored         PetStored[]
}

model Game {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  imageUrl    String
  category    String
  description String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  profiles    GameProfile[]
  stats       PlayerStat[]
  lfgPosts    LfgPost[]
  tournaments Tournament[]
  customs     Custom[]
}

model GameProfile {
  id         String  @id @default(cuid())
  userId     String
  gameId     String
  inGameName String
  rank       String?
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  game       Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

model PlayerStat {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  points    Int      @default(0)
  wins      Int      @default(0)
  losses    Int      @default(0)
  matches   Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId, points])
}

model Friendship {
  id          String       @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  requester   User         @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User         @relation("Addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

model LfgPost {
  id          String    @id @default(cuid())
  authorId    String
  gameId      String
  title       String
  description String?
  slots       Int       @default(5)
  rankHint    String?
  open        Boolean   @default(true)
  createdAt   DateTime  @default(now())
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  game        Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  joins       LfgJoin[]
  announcedAt DateTime? // kdy to bot oznámil na Discordu

  @@index([gameId, open, createdAt])
}

model LfgJoin {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      LfgPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model Tournament {
  id          String            @id @default(cuid())
  gameId      String
  organizerId String
  name        String
  description String
  startsAt    DateTime
  maxPlayers  Int               @default(16)
  status      EventStatus       @default(UPCOMING)
  prize       String?
  teamSize    Int               @default(1) // 1 = hraje se solo, víc = týmy
  createdAt   DateTime          @default(now())
  game        Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)
  organizer   User              @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  entries     TournamentEntry[]
  teams       TournamentTeam[]
  matches     TournamentMatch[]
  championName String?
  settledAt   DateTime?
  announcedAt DateTime? // kdy to bot oznámil na Discordu

  @@index([startsAt])
  @@index([status, startsAt])
}

model TournamentEntry {
  id           String          @id @default(cuid())
  tournamentId String
  userId       String
  teamId       String?
  createdAt    DateTime        @default(now())
  tournament   Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  team         TournamentTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([tournamentId, userId])
  @@index([userId])
}

/// Tým přihlášený do turnaje. Členové jsou záznamy TournamentEntry s teamId.
model TournamentTeam {
  id           String            @id @default(cuid())
  tournamentId String
  name         String
  captainId    String
  createdAt    DateTime          @default(now())
  tournament   Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  captain      User              @relation("TeamCaptain", fields: [captainId], references: [id], onDelete: Cascade)
  teamId       String? // odkaz na trvalý tým, ze kterého vznikl
  entries      TournamentEntry[]

  @@unique([tournamentId, name])
}

model Custom {
  id          String        @id @default(cuid())
  gameId      String
  hostId      String
  title       String
  description String?
  startsAt    DateTime
  maxPlayers  Int           @default(10)
  status      EventStatus   @default(UPCOMING)
  createdAt   DateTime      @default(now())
  game        Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  host        User          @relation(fields: [hostId], references: [id], onDelete: Cascade)
  entries     CustomEntry[]
  announcedAt DateTime? // kdy to bot oznámil na Discordu

  @@index([startsAt])
  @@index([status, startsAt])
}

model CustomEntry {
  id        String   @id @default(cuid())
  customId  String
  userId    String
  createdAt DateTime @default(now())
  custom    Custom   @relation(fields: [customId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([customId, userId])
  @@index([userId])
}

model Ticket {
  id        String          @id @default(cuid())
  authorId  String
  subject   String
  category  String
  status    TicketStatus    @default(OPEN)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  author    User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  messages  TicketMessage[]

  @@index([status, updatedAt])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String
  fromStaff Boolean  @default(false)
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model GameSuggestion {
  id         String     @id @default(cuid())
  proposerId String
  name       String
  reason     String?
  storeUrl   String?
  createdAt  DateTime   @default(now())
  proposer   User       @relation(fields: [proposerId], references: [id], onDelete: Cascade)
  votes      GameVote[]
}

model GameVote {
  id           String         @id @default(cuid())
  suggestionId String
  userId       String
  createdAt    DateTime       @default(now())
  suggestion   GameSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([suggestionId, userId])
}

/// Propojený externí účet hráče (Steam nebo Riot). Jeden účet od každého poskytovatele na hráče.
model LinkedAccount {
  id            String   @id @default(cuid())
  userId        String
  provider      String // "steam" | "riot"
  externalId    String // steamid64 nebo Riot PUUID
  displayName   String // Steam nick nebo Riot ID (Jmeno#TAG)
  gameName      String? // Riot: část před #
  tagLine       String? // Riot: část za #
  region        String? // Riot: platforma LoL, např. eun1
  avatarUrl     String?
  profileUrl    String?
  verified      Boolean  @default(false)
  shareValorant Boolean  @default(false) // souhlas hráče se zobrazením Valorant dat
  verifyIcon    Int? // Riot: ikona, kterou má hráč nastavit pro ověření vlastnictví
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, externalId]) // víc Riot účtů na hráče; Steam jen jeden (hlídá kód)
  // Neověřené propojení nesmí blokovat skutečného majitele, proto tu není unique.
  // Jeden OVĚŘENÝ vlastník na účet se hlídá v kódu.
  @@index([provider, externalId])
  @@index([userId, provider])
}

/// Krátkodobá cache odpovědí externích API (šetří limity Riot / Steam).
model StatCache {
  key       String   @id
  data      Json
  fetchedAt DateTime @default(now())
}

/// Esportový zápas (LEC, Worlds, VCT…). Zadává admin ručně, případně se doplňuje synchronizací.
model EsportsMatch {
  id         String   @id @default(cuid())
  game       String // "lol" | "valorant"
  league     String // např. "LEC", "Worlds"
  stage      String? // např. "Playoffs", "Swiss, kolo 3"
  startsAt   DateTime
  bestOf     Int      @default(1)
  teamA      String
  teamB      String
  logoA      String?
  logoB      String?
  scoreA     Int?
  scoreB     Int?
  status     String   @default("upcoming") // upcoming | live | finished
  streamUrl  String?
  source     String   @default("manual") // manual | sync
  externalId String?  @unique
  createdAt  DateTime @default(now())

  picks Pick[]

  @@index([startsAt])
  @@index([game, league])
}

/// Záznam ranku hráče v čase (pro graf vývoje LP). Plní se při načtení profilu a z bota.
model RankSnapshot {
  id       String   @id @default(cuid())
  puuid    String
  queue    String // RANKED_SOLO_5x5 | RANKED_FLEX_SR
  tier     String
  division String
  lp       Int
  wins     Int
  losses   Int
  takenAt  DateTime @default(now())

  @@index([puuid, queue, takenAt])
}

/// Tip hráče na esportový zápas (Pick'Em). Body se doplní, až je zápas dohraný.
model Pick {
  id        String       @id @default(cuid())
  userId    String
  matchId   String
  winner    String // "A" | "B"
  scoreA    Int?
  scoreB    Int?
  points    Int? // null = ještě nevyhodnoceno
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  match     EsportsMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([matchId])
}

/// Novinky od adminů na hlavní stránce.
model News {
  id        String   @id @default(cuid())
  authorId  String?
  title     String
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  announcedAt DateTime? // kdy to bot oznámil na Discordu

  @@index([pinned, createdAt])
}

/// Záznam citlivých akcí (kdo co smazal, zablokoval, změnil).
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String? // bez vazby, aby záznam přežil smazání účtu
  actorName String
  action    String
  target    String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Zápas v turnajovém pavouku (single elimination). Účastník = "e:<entryId>" (solo) nebo "t:<teamId>".
model TournamentMatch {
  id           String   @id @default(cuid())
  tournamentId String
  round        Int // 1 = první kolo
  position     Int // pořadí v kole od 0
  refA         String?
  refB         String?
  nameA        String?
  nameB        String?
  scoreA       Int?
  scoreB       Int?
  winner       String? // "A" | "B"
  status       String   @default("pending") // pending | reported | confirmed
  reportedById String?
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, round, position])
}

/// Trvalý tým, který hráči přihlašují do turnajů opakovaně.
model Team {
  id        String       @id @default(cuid())
  name      String       @unique
  tag       String?
  logoUrl   String?
  captainId String
  createdAt DateTime     @default(now())
  members   TeamMember[]
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  userId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

/// Odznak na profilu hráče.
model Badge {
  id           String   @id @default(cuid())
  userId       String
  key          String // champion | finalist | player
  tournamentId String   @default("")
  label        String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key, tournamentId])
}

/// Oznámení hráči. Zobrazí se na webu a bot je může rozeslat do Discord DM (poll přes /api/bot/outbox).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String // friend | tournament | match | custom | lfg | pickem
  title     String
  body      String?
  url       String?
  dedupeKey String?   @unique
  readAt    DateTime?
  sentAt    DateTime? // kdy ho převzal bot
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([sentAt])
}

/// Pet hráče. Roste s odehranými hrami, nekrmený chátrá (vzhled se vrací o stupně zpět, XP se neztrácí).
model Pet {
  id          String   @id @default(cuid())
  userId      String   @unique
  species     String // dragon | cat | mushroom | butterfly | bat
  name        String
  xp          Int      @default(0)
  coins       Int      @default(0)
  treats      Int      @default(3)
  lastFedAt   DateTime @default(now())
  adoptedAt   DateTime @default(now())
  hat         String?
  bg          String?
  tint        String?
  gear        String   @default("{}")
  slots       Int      @default(1) // kolik petů smí hráč vlastnit (další slot stojí mince)
  lastSyncAt  DateTime?
  socialDay   String   @default("")
  socialCount Int      @default(0)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Další pet ve sbírce (aktivní pet je v tabulce Pet). Odpočívající pet nehladoví: hungerMs je doba bez pamlsku v okamžiku uložení.
model PetStored {
  id        String   @id @default(cuid())
  userId    String
  species   String
  name      String
  xp        Int      @default(0)
  hungerMs  Int      @default(0)
  gear      String   @default("{}")
  adoptedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, species])
}

/// Zápas, za který už hráč dostal odměnu (brání dvojímu započtení).
model PetGame {
  id        String   @id @default(cuid())
  userId    String
  matchId   String
  counted   Boolean  @default(true)
  social    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, matchId])
  @@index([userId])
}

model PetItem {
  id     String @id @default(cuid())
  userId String
  key    String

  @@unique([userId, key])
}
