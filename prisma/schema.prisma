generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MOD
  ADMIN
}

enum FriendStatus {
  PENDING
  ACCEPTED
}

enum EventStatus {
  UPCOMING
  LIVE
  FINISHED
  CANCELLED
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

model User {
  id          String   @id @default(cuid())
  discordId   String   @unique
  username    String
  handle      String   @unique
  avatarUrl   String?
  bio         String?
  accent      String   @default("#7c5cff")
  locale      String   @default("cs")
  role        Role     @default(USER)
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  gameProfiles   GameProfile[]
  stats          PlayerStat[]
  sentFriends    Friendship[]  @relation("Requester")
  receivedFriends Friendship[] @relation("Addressee")
  lfgPosts       LfgPost[]
  lfgJoins       LfgJoin[]
  tournaments    Tournament[]
  tournamentEntries TournamentEntry[]
  customs        Custom[]
  customEntries  CustomEntry[]
  tickets        Ticket[]
  ticketMessages TicketMessage[]
  suggestions    GameSuggestion[]
  votes          GameVote[]
}

model Game {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  imageUrl    String
  category    String
  description String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  profiles    GameProfile[]
  stats       PlayerStat[]
  lfgPosts    LfgPost[]
  tournaments Tournament[]
  customs     Custom[]
}

model GameProfile {
  id         String @id @default(cuid())
  userId     String
  gameId     String
  inGameName String
  rank       String?
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  game       Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

model PlayerStat {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  points    Int      @default(0)
  wins      Int      @default(0)
  losses    Int      @default(0)
  matches   Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId, points])
}

model Friendship {
  id           String       @id @default(cuid())
  requesterId  String
  addresseeId  String
  status       FriendStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  requester    User         @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee    User         @relation("Addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
}

model LfgPost {
  id          String   @id @default(cuid())
  authorId    String
  gameId      String
  title       String
  description String?
  slots       Int      @default(5)
  rankHint    String?
  open        Boolean  @default(true)
  createdAt   DateTime @default(now())
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  joins       LfgJoin[]

  @@index([gameId, open, createdAt])
}

model LfgJoin {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      LfgPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Tournament {
  id          String      @id @default(cuid())
  gameId      String
  organizerId String
  name        String
  description String
  startsAt    DateTime
  maxPlayers  Int         @default(16)
  status      EventStatus @default(UPCOMING)
  prize       String?
  createdAt   DateTime    @default(now())
  game        Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  organizer   User        @relation(fields: [organizerId], references: [id])
  entries     TournamentEntry[]

  @@index([startsAt])
}

model TournamentEntry {
  id           String     @id @default(cuid())
  tournamentId String
  userId       String
  createdAt    DateTime   @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
}

model Custom {
  id          String      @id @default(cuid())
  gameId      String
  hostId      String
  title       String
  description String?
  startsAt    DateTime
  maxPlayers  Int         @default(10)
  status      EventStatus @default(UPCOMING)
  createdAt   DateTime    @default(now())
  game        Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  host        User        @relation(fields: [hostId], references: [id])
  entries     CustomEntry[]

  @@index([startsAt])
}

model CustomEntry {
  id        String   @id @default(cuid())
  customId  String
  userId    String
  createdAt DateTime @default(now())
  custom    Custom   @relation(fields: [customId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([customId, userId])
}

model Ticket {
  id        String       @id @default(cuid())
  authorId  String
  subject   String
  category  String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  messages  TicketMessage[]

  @@index([status, updatedAt])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String
  fromStaff Boolean  @default(false)
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model GameSuggestion {
  id          String   @id @default(cuid())
  proposerId  String
  name        String
  reason      String?
  storeUrl    String?
  createdAt   DateTime @default(now())
  proposer    User     @relation(fields: [proposerId], references: [id], onDelete: Cascade)
  votes       GameVote[]
}

model GameVote {
  id           String         @id @default(cuid())
  suggestionId String
  userId       String
  createdAt    DateTime       @default(now())
  suggestion   GameSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([suggestionId, userId])
}
