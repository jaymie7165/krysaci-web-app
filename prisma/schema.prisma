generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MOD
  ADMIN
}

enum FriendStatus {
  PENDING
  ACCEPTED
}

enum EventStatus {
  UPCOMING
  LIVE
  FINISHED
  CANCELLED
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

model User {
  id          String   @id @default(cuid())
  discordId   String   @unique
  username    String
  handle      String   @unique
  avatarUrl   String?
  bio         String?
  accent      String   @default("#8b5cf6")
  locale      String   @default("cs")
  role        Role     @default(USER)
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  showActivity Boolean @default(true) // zda web ukazuje, jakou hru hráč právě hraje

  gameProfiles   GameProfile[]
  stats          PlayerStat[]
  sentFriends    Friendship[]  @relation("Requester")
  receivedFriends Friendship[] @relation("Addressee")
  lfgPosts       LfgPost[]
  lfgJoins       LfgJoin[]
  tournaments    Tournament[]
  tournamentEntries TournamentEntry[]
  customs        Custom[]
  customEntries  CustomEntry[]
  tickets        Ticket[]
  ticketMessages TicketMessage[]
  suggestions    GameSuggestion[]
  votes          GameVote[]
  linkedAccounts LinkedAccount[]
}

model Game {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  imageUrl    String
  category    String
  description String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  profiles    GameProfile[]
  stats       PlayerStat[]
  lfgPosts    LfgPost[]
  tournaments Tournament[]
  customs     Custom[]
}

model GameProfile {
  id         String @id @default(cuid())
  userId     String
  gameId     String
  inGameName String
  rank       String?
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  game       Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

model PlayerStat {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  points    Int      @default(0)
  wins      Int      @default(0)
  losses    Int      @default(0)
  matches   Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId, points])
}

model Friendship {
  id           String       @id @default(cuid())
  requesterId  String
  addresseeId  String
  status       FriendStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  requester    User         @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee    User         @relation("Addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
}

model LfgPost {
  id          String   @id @default(cuid())
  authorId    String
  gameId      String
  title       String
  description String?
  slots       Int      @default(5)
  rankHint    String?
  open        Boolean  @default(true)
  createdAt   DateTime @default(now())
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  joins       LfgJoin[]

  @@index([gameId, open, createdAt])
}

model LfgJoin {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      LfgPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Tournament {
  id          String      @id @default(cuid())
  gameId      String
  organizerId String
  name        String
  description String
  startsAt    DateTime
  maxPlayers  Int         @default(16)
  status      EventStatus @default(UPCOMING)
  prize       String?
  createdAt   DateTime    @default(now())
  game        Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  organizer   User        @relation(fields: [organizerId], references: [id])
  entries     TournamentEntry[]

  @@index([startsAt])
}

model TournamentEntry {
  id           String     @id @default(cuid())
  tournamentId String
  userId       String
  createdAt    DateTime   @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
}

model Custom {
  id          String      @id @default(cuid())
  gameId      String
  hostId      String
  title       String
  description String?
  startsAt    DateTime
  maxPlayers  Int         @default(10)
  status      EventStatus @default(UPCOMING)
  createdAt   DateTime    @default(now())
  game        Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  host        User        @relation(fields: [hostId], references: [id])
  entries     CustomEntry[]

  @@index([startsAt])
}

model CustomEntry {
  id        String   @id @default(cuid())
  customId  String
  userId    String
  createdAt DateTime @default(now())
  custom    Custom   @relation(fields: [customId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([customId, userId])
}

model Ticket {
  id        String       @id @default(cuid())
  authorId  String
  subject   String
  category  String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  messages  TicketMessage[]

  @@index([status, updatedAt])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String
  fromStaff Boolean  @default(false)
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model GameSuggestion {
  id          String   @id @default(cuid())
  proposerId  String
  name        String
  reason      String?
  storeUrl    String?
  createdAt   DateTime @default(now())
  proposer    User     @relation(fields: [proposerId], references: [id], onDelete: Cascade)
  votes       GameVote[]
}

model GameVote {
  id           String         @id @default(cuid())
  suggestionId String
  userId       String
  createdAt    DateTime       @default(now())
  suggestion   GameSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([suggestionId, userId])
}

/// Propojený externí účet hráče (Steam nebo Riot). Jeden účet od každého poskytovatele na hráče.
model LinkedAccount {
  id           String   @id @default(cuid())
  userId       String
  provider     String   // "steam" | "riot"
  externalId   String   // steamid64 nebo Riot PUUID
  displayName  String   // Steam nick nebo Riot ID (Jmeno#TAG)
  gameName     String?  // Riot: část před #
  tagLine      String?  // Riot: část za #
  region       String?  // Riot: platforma LoL, např. eun1
  avatarUrl    String?
  profileUrl   String?
  verified     Boolean  @default(false)
  shareValorant Boolean @default(false) // souhlas hráče se zobrazením Valorant dat
  verifyIcon   Int?     // Riot: ikona, kterou má hráč nastavit pro ověření vlastnictví
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  // Neověřené propojení nesmí blokovat skutečného majitele, proto tu není unique.
  // Jeden OVĚŘENÝ vlastník na účet se hlídá v kódu.
  @@index([provider, externalId])
}

/// Krátkodobá cache odpovědí externích API (šetří limity Riot / Steam).
model StatCache {
  key       String   @id
  data      Json
  fetchedAt DateTime @default(now())
}

/// Esportový zápas (LEC, Worlds, VCT…). Zadává admin ručně, případně se doplňuje synchronizací.
model EsportsMatch {
  id         String   @id @default(cuid())
  game       String   // "lol" | "valorant"
  league     String   // např. "LEC", "Worlds"
  stage      String?  // např. "Playoffs", "Swiss, kolo 3"
  startsAt   DateTime
  bestOf     Int      @default(1)
  teamA      String
  teamB      String
  logoA      String?
  logoB      String?
  scoreA     Int?
  scoreB     Int?
  status     String   @default("upcoming") // upcoming | live | finished
  streamUrl  String?
  source     String   @default("manual")   // manual | sync
  externalId String?  @unique
  createdAt  DateTime @default(now())

  @@index([startsAt])
  @@index([game, league])
}

/// Záznam ranku hráče v čase (pro graf vývoje LP). Plní se při načtení profilu a z bota.
model RankSnapshot {
  id       String   @id @default(cuid())
  puuid    String
  queue    String   // RANKED_SOLO_5x5 | RANKED_FLEX_SR
  tier     String
  division String
  lp       Int
  wins     Int
  losses   Int
  takenAt  DateTime @default(now())

  @@index([puuid, queue, takenAt])
}
